APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://<user>:<password>@<neon-host>/<database>?sslmode=require
SECRET_KEY=replace-with-a-random-local-secret
# Configure these three together only when Google Login is enabled.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Required in production because the catalogue can build public image URLs.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Required to deliver public contact-form messages through Resend.
RESEND_API_KEY=your-resend-api-key
CONTACT_FROM_EMAIL=contact@your-verified-domain.example
CONTACT_TO_EMAIL=your-contact-inbox@example.com
