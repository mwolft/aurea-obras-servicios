APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://<user>:<password>@<neon-host>/<database>?sslmode=require
SECRET_KEY=replace-with-a-random-local-secret
# Configure these three together only when Google Login is enabled.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Required in production because the catalogue can build public image URLs.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Shared Resend sender for public contact messages and rental transactional emails.
# CONTACT_TO_EMAIL receives public Contact requests and the small set of internal
# rental/fianza alerts that require administrative review.
RESEND_API_KEY=your-resend-api-key
CONTACT_FROM_EMAIL=contact@your-verified-domain.example
CONTACT_TO_EMAIL=your-contact-inbox@example.com
# Required to create Stripe Checkout sessions and verify Stripe webhook events.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
# Required to create and verify PayPal Checkout Orders. Use sandbox locally and
# live only with live credentials and the live webhook ID.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_ENVIRONMENT=sandbox
